NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Local development examples only. Choose your own values in the ignored .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ploggr
DB_USER=ploggr
DB_PASSWORD=ploggr_dev_only
# Used only by Compose for database initialization; never used by the backend.
POSTGRES_PASSWORD=postgres_dev_only

# Nest-only signing and rotation key. Generate in .env with node tool/setup-auth-key.mjs.

# Local private object storage. The setup command generates the two storage keys.
EVIDENCE_S3_BUCKET=ploggr-evidence
EVIDENCE_S3_ENDPOINT=http://127.0.0.1:8333

# Optional field services. External credentials belong only on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PHOTON_URL=
MODERATOR_IDS=
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_METHODS=
RESEND_API_KEY=
MAIL_FROM=
